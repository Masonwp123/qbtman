QBT_API_TOKEN=qbt_CHANGE_ME
GLUETUN_API_KEY=CHANGE_ME

# Wireguard:
PROTON_EMAIL=MyProtonUsername@email.com
PROTON_PASSWORD=MyProtonPassword

# 'PublicKey' in [Peer]
WIREGUARD_PUBLIC_KEY=CHANGE_ME
# 'PrivateKey' in [Interface]
WIREGUARD_PRIVATE_KEY=CHANGE_ME
# 'Address' in [Interface]
WIREGUARD_ADDRESSES=IP/Subnet
# 'Endpoint' in [Peer]
WIREGUARD_ENDPOINT_IP=IP
# Should default to 51820
WIREGUARD_ENDPOINT_PORT=51820
# 'DNS' in [Interface]
VPN_DNS_ADDRESS=IP